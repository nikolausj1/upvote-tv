<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Copy this file to `Secrets.plist` (same folder) and fill in your values.
        Secrets.plist is gitignored. Both files live inside the target so Xcode's
        file-system-synchronized group picks them up automatically.

        GistID:    the ID segment of your secret gist's URL
                   (e.g. https://gist.github.com/you/abc123def456 → "abc123def456")
        GistToken: a GitHub fine-grained Personal Access Token scoped to
                   "Gists: read+write" only. Generate one at
                   github.com/settings/tokens?type=beta
    -->
    <key>GistID</key>
    <string></string>
    <key>GistToken</key>
    <string></string>
</dict>
</plist>
